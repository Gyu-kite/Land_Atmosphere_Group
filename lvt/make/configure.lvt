FC              = mpifort
FC77            = mpifort
LD              = mpifort
CC              = mpicc
AR              = ar
MOD_ESMF        = /usr/local/esmf/8.7.0_intel21_mpich/mod/modO/Linux.intel.64.mpich.default
LIB_ESMF        = /usr/local/esmf/8.7.0_intel21_mpich/lib/libO/Linux.intel.64.mpich.default
INC_JPEG2000      = /usr/local/openjpeg/2.5.0_intel21/include/
LIB_JPEG2000      = /usr/local/openjpeg/2.5.0_intel21/lib64/
INC_ECCODES     = /usr/local/include/
LIB_ECCODES     = /usr/local/lib64/
INC_NETCDF      = /usr/local/netcdf/4.9.2_intel21_parallel/include/
LIB_NETCDF      = /usr/local/netcdf/4.9.2_intel21_parallel/lib/
INC_HDF4        = /usr/local/hdf4/4.3.0_intel21/include/
LIB_HDF4        = /usr/local/hdf4/4.3.0_intel21/lib/
INC_HDF5        = /usr/local/hdf5/1.14.6_parallel/include/
LIB_HDF5        = /usr/local/hdf5/1.14.6_parallel/lib/
INC_HDFEOS      = /usr/local/hdfeos2/3.0_intel21/include/
LIB_HDFEOS      = /usr/local/hdfeos2/3.0_intel21/lib/
INC_FORTRANGIS1 = 
INC_FORTRANGIS2 = 
LIB_FORTRANGIS  = 
LIB_GDAL        = 
CFLAGS          = -c  -traceback -DIFC
FFLAGS77        = -c -O2  -traceback -nomixed-str-len-arg -names lowercase -convert big_endian -assume byterecl  -DIFC -I$(MOD_ESMF)  -I$(INC_ECCODES) -I$(INC_NETCDF)  -I$(INC_HDFEOS)  -I$(INC_HDF4)  -I$(INC_HDF5) 
FFLAGS          =  -c -O2  -u -traceback -fpe0  -nomixed-str-len-arg -names lowercase -convert big_endian -assume byterecl -DIFC -I$(MOD_ESMF)  -I$(INC_ECCODES) -I$(INC_NETCDF)  -I$(INC_HDFEOS)  -I$(INC_HDF4)  -I$(INC_HDF5) 
LDFLAGS         =  -L$(LIB_ESMF) -lesmf -lpioc -lstdc++ -limf -lm -lrt  -L$(LIB_ECCODES) -leccodes_f90 -leccodes -L$(LIB_JPEG2000) -ljasper -L$(LIB_NETCDF) -lnetcdff -lnetcdf -L$(LIB_HDFEOS) -lhdfeos -lGctp -L$(LIB_HDF4) -lmfhdf -ldf -ljpeg -lz  -L$(LIB_HDF5) -lhdf5_fortran -lhdf5_hl -lhdf5 -ldl
