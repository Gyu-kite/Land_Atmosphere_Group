source /etc/profile.d/modules.sh

# 모듈 설정`
module purge
module load intel21/compiler-21
module load intel21/mpich-3.4.1

# 아키텍처 지정
export LVT_ARCH=linux_ifc
# 컴파일러
export LVT_FC=mpifort
export LVT_LD=mpifort
export LVT_CC=mpicc

# 최신 라이브러리 경로
export LVT_NETCDF=/usr/local/netcdf/4.9.2_intel21_parallel
export LVT_HDF5=/usr/local/hdf5/1.14.6_parallel
export LVT_HDF4=/usr/local/hdf4/4.3.0_intel21
export LVT_HDFEOS=/usr/local/hdfeos2/3.0_intel21
export LVT_ECCODES=/usr/local/             # eccodes 2.22.0
export LVT_JASPER=/usr/local/openjpeg/2.5.0_intel21  # openjpeg 사용

# ESMF (최신 빌드된 라이브러리)
export LVT_MODESMF=/usr/local/esmf/8.7.0_intel21_mpich/mod/modO/Linux.intel.64.mpich.default
export LVT_LIBESMF=/usr/local/esmf/8.7.0_intel21_mpich/lib/libO/Linux.intel.64.mpich.default

# LD_LIBRARY_PATH 설정
export LD_LIBRARY_PATH=\
${LVT_HDF4}/lib:${LVT_HDF5}/lib:${LVT_NETCDF}/lib:\
${LVT_MODESMF}:${LVT_LIBESMF}:${LVT_HDFEOS}/lib:\
${LVT_ECCODES}/lib64:${LVT_JASPER}/lib64:${LD_LIBRARY_PATH}

# configure 실행
./configure
#h5pcc -showconfig | grep "Parallel HDF5"

