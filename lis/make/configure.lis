FC              = mpifort
FC77            = mpifort
LD              = mpifort
CC              = mpicc
AR              = ar
MOD_ESMF        = /usr/local/esmf/8.7.0_intel21_mpich/mod/modO/Linux.intel.64.mpich.default
LIB_ESMF        = /usr/local/esmf/8.7.0_intel21_mpich/lib/libO/Linux.intel.64.mpich.default
INC_JPEG2000      = /usr/local/openjpeg/2.5.0_intel21/include/
LIB_JPEG2000      = /usr/local/openjpeg/2.5.0_intel21/lib64/
INC_ECCODES     = /usr/local/include/
LIB_ECCODES     = /usr/local/lib64/
INC_NETCDF      = /usr/local/netcdf/4.9.2_intel21_parallel/include/
LIB_NETCDF      = /usr/local/netcdf/4.9.2_intel21_parallel/lib/
INC_HDF4        = /usr/local/hdf4/4.3.0_intel21/include/
LIB_HDF4        = /usr/local/hdf4/4.3.0_intel21/lib/
INC_HDF5        = /usr/local/hdf5/1.14.6_parallel/include/
LIB_HDF5        = /usr/local/hdf5/1.14.6_parallel/lib/
INC_HDFEOS      = /usr/local/hdfeos2/3.0_intel21/include/
LIB_HDFEOS      = /usr/local/hdfeos2/3.0_intel21/lib/
LIB_MINPACK     = 
INC_CRTM        = 
LIB_CRTM        = 
INC_PROF_UTIL   = 
LIB_PROF_UTIL   = 
INC_CMEM        = 
LIB_CMEM        = 
LIB_LAPACK      = /usr/local/intel/oneapi/mkl/latest/lib/intel64
INC_PETSC       = 
LIB_PETSC       = 
CFLAGS          = -c  -fp-model precise -traceback -DIFC -DLINUX -DLIS_JULES
FFLAGS77        = -c  -O2  -fp-model precise -traceback -nomixed-str-len-arg -names lowercase -convert big_endian -assume byterecl -DSPMD -DHIDE_SHR_MSG -DNO_SHR_VMATH -DIFC -DLINUX -I$(MOD_ESMF) -DUSE_INCLUDE_MPI -I$(INC_ECCODES) -I$(INC_NETCDF) -I$(INC_HDFEOS) -I$(INC_HDF4) -I$(INC_HDF5) -DLIS_JULES
FFLAGS          = -c  -O2  -fp-model precise -u -traceback -fpe0 -nomixed-str-len-arg -names lowercase -convert big_endian -assume byterecl -DSPMD -DHIDE_SHR_MSG -DNO_SHR_VMATH -DIFC -DLINUX -I$(MOD_ESMF) -DUSE_INCLUDE_MPI -I$(INC_ECCODES) -I$(INC_NETCDF) -I$(INC_HDFEOS) -I$(INC_HDF4) -I$(INC_HDF5) -DLIS_JULES #-I/home/gychoi/JULES/for_LIS/trunk/build/include
LDFLAGS         =  -L$(LIB_ESMF) -lesmf -lpioc -lstdc++ -limf -lrt -lmpi -L$(LIB_ECCODES) -leccodes_f90 -leccodes -L$(LIB_JPEG2000) -ljasper -L$(LIB_NETCDF) -lnetcdff -lnetcdf -L$(LIB_HDFEOS) -lhdfeos -lGctp -L$(LIB_HDF4) -lmfhdf -ldf -ljpeg -lz  -L$(LIB_HDF5) -lhdf5_fortran -lhdf5_hl -lhdf5 -lz -L$(LIB_LAPACK) -Wl,-rpath,$(LIB_LAPACK) -lmkl_intel_lp64 -lmkl_sequential -lmkl_core -lpthread -lm -ldl
LIS_LIB_FLAGS   = -lesmf -lpioc -lstdc++ -limf -lrt -leccodes_f90 -leccodes -ljasper -lnetcdff -lnetcdf -lhdfeos -lGctp -lmfhdf -ldf -ljpeg -lz -lhdf5_fortran -lhdf5_hl -lhdf5
LIS_LIB_PATHS   = -L$(LIB_ESMF) -L$(LIB_ECCODES) -L$(LIB_JPEG2000) -L$(LIB_NETCDF) -L$(LIB_HDFEOS) -L$(LIB_HDF4) -L$(LIB_HDF5)
